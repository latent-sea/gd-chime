; gd-chime. MIT licensed; see the LICENCE file beside this one.
;
; The folder's own project file, so that a copy of this folder ALONE opens and
; runs - which is the claim the extraction check exists to keep true.
;
; Godot rewrites this file whenever the editor saves, and drops comments when
; it does. Nothing here may be load-bearing on being read.

config_version=5

[application]

config/name="gd-chime"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]

; the base size an application's canvas is drawn at (easel.gd), so a size is written once in the theme: layouts are anchors, shares of a rect, and never compute pixels
window/size/viewport_width=1920
window/size/viewport_height=1080
; the window is NOT stretched: an application scales itself on its easel at real pixels, and a stretched window would scale it twice
window/stretch/mode="disabled"

[input]

; the pad's A added to the accept action, its keys kept: measured on 4.6.2, the engine's own accept holds no pad button, while its directions already hold the d-pad and the left stick
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}

[rendering]

renderer/rendering_method="forward_plus"
